generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users       User[]
  courses     Course[]
  groups      Group[]
  leads       Lead[]
  payments    Payment[]
  debts       Debt[]
  attendances Attendance[]
  tasks       Task[]
  materials   Material[]
}

model User {
  id             Int             @id @default(autoincrement())
  name           String
  phone          String          @unique
  password       String
  role           Role            @default(STUDENT)
  telegramId     String?
  tenantId       Int?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant?         @relation(fields: [tenantId], references: [id])
  attendances    Attendance[]
  groupsTaught   Group[]         @relation("TeacherGroups")
  payments       Payment[]
  debts          Debt[]
  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  submissions    Submission[]
}

model TeacherProfile {
  id                Int    @id @default(autoincrement())
  userId            Int    @unique
  subject           String
  baseSalary        Float
  paymentPercentage Float  @default(0)
  rating            Float  @default(0)
  bonus             Float  @default(0)
  user              User   @relation(fields: [userId], references: [id])
}

model StudentProfile {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  level     Int       @default(1)
  coins     Int       @default(0)
  joinedAt  DateTime  @default(now())
  subEndsAt DateTime?
  groups    Group[]
  user      User      @relation(fields: [userId], references: [id])
}

model Lead {
  id        Int        @id @default(autoincrement())
  name      String
  course    String
  phone     String
  source    String
  status    LeadStatus @default(NEW)
  reason    String?
  tenantId  Int?
  createdAt DateTime   @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
}

model Course {
  id           Int     @id @default(autoincrement())
  name         String
  monthlyPrice Float
  description  String?
  tenantId     Int?
  groups       Group[]

  tenant Tenant? @relation(fields: [tenantId], references: [id])
}

model Group {
  id             Int              @id @default(autoincrement())
  name           String
  courseId       Int
  teacherId      Int
  schedule       String
  classDays      Int[]
  classTime      String?
  telegramChatId String?
  tenantId       Int?
  attendances    Attendance[]
  debts          Debt[]
  payments       Payment[]
  course         Course           @relation(fields: [courseId], references: [id])
  teacher        User             @relation("TeacherGroups", fields: [teacherId], references: [id])
  tenant         Tenant?          @relation(fields: [tenantId], references: [id])
  students       StudentProfile[]
  tasks          Task[]
}

model Payment {
  id          Int       @id @default(autoincrement())
  studentId   Int
  groupId     Int?
  amount      Float
  paymentDate DateTime  @default(now())
  periodStart DateTime?
  month       String
  status      String    @default("paid")
  method      String
  receiptUrl  String?
  tenantId    Int?

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group   Group?  @relation(fields: [groupId], references: [id])
  tenant  Tenant? @relation(fields: [tenantId], references: [id])
}

model Debt {
  id        Int      @id @default(autoincrement())
  studentId Int
  groupId   Int?
  amount    Float
  month     String
  status    String   @default("UNPAID")
  tenantId  Int?
  createdAt DateTime @default(now())

  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group   Group?  @relation(fields: [groupId], references: [id])
  tenant  Tenant? @relation(fields: [tenantId], references: [id])
}

model Attendance {
  id        Int      @id @default(autoincrement())
  studentId Int
  groupId   Int
  date      DateTime @default(now())
  present   Boolean  @default(true)
  tenantId  Int?
  group     Group    @relation(fields: [groupId], references: [id])
  student   User     @relation(fields: [studentId], references: [id])
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum LeadStatus {
  NEW
  THINKING
  REJECTED
}

model Task {
  id          Int          @id @default(autoincrement())
  title       String
  deadline    DateTime
  groupId     Int
  totalCount  Int          @default(0)
  createdAt   DateTime     @default(now())
  status      String       @default("active")
  tenantId    Int?
  group       Group        @relation(fields: [groupId], references: [id])
  tenant      Tenant?      @relation(fields: [tenantId], references: [id])
  submissions Submission[]
}

model Submission {
  id        Int      @id @default(autoincrement())
  taskId    Int
  studentId Int
  score     Int?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  student   User     @relation(fields: [studentId], references: [id])
  task      Task     @relation(fields: [taskId], references: [id])
}

model Material {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  size      String
  courseId  Int?
  groupId   Int?
  tenantId  Int?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])
}
